#!/usr/bin/env bash
# Debian image workspaces. Self-contained for easy installation.
set -Eeuo pipefail

APP_NAME="Chrootable Manager"
APP_VERSION=3.0.0
SCRIPT_PATH=${BASH_SOURCE[0]}
STORE_DIR=${CHROOTABLE_HOME:-/var/lib/chrootable-manager}
DEBIAN_SUITE=${CHROOTABLE_DEBIAN_SUITE:-stable}
DEBIAN_MIRROR=${CHROOTABLE_DEBIAN_MIRROR:-https://deb.debian.org/debian}
NON_INTERACTIVE=1
DEMO=0
REQUIRED_COMMANDS=(awk basename chmod chroot cp date dd debootstrap df dpkg du e2fsck find flock gpgv
    gzip hostname install ip losetup mkdir mkfs.ext4 mktemp mount mountpoint mv readlink
    resize2fs rm rmdir sha256sum stat tail tar truncate umount unshare wget whiptail xz)

configure_paths() {
    IMAGE_DIR="$STORE_DIR/images"
    LOG_DIR="$STORE_DIR/logs"
    EXPORT_DIR="$STORE_DIR/exports"
    SNAPSHOT_DIR="$STORE_DIR/snapshots"
    ARCHIVE_DIR="$STORE_DIR/archive"
}
configure_paths

fail() { printf 'Error: %s\n' "$*" >&2; return 1; }
info() { printf '%s\n' "$*" >&2; }
valid_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }
valid_size_mib() {
    [[ $1 =~ ^[1-9][0-9]*$ ]] && { (( ${#1} < 7 )) || { (( ${#1} == 7 )) && [[ $1 < 1048577 ]]; }; }
}
valid_lifecycle() { [[ $1 == persistent || $1 == ephemeral ]]; }
valid_profile() { [[ $1 == minimal || $1 == build || $1 == python || $1 == network || $1 == rust || $1 == go || $1 == web ]]; }
valid_profiles() {
    local profile
    for profile in "$@"; do
        valid_profile "$profile" || return 1
    done
    return 0
}
valid_suite() { [[ $1 =~ ^[a-z0-9][a-z0-9.-]{0,31}$ ]]; }
valid_mirror() { [[ $1 =~ ^https://[A-Za-z0-9._-]+(:[0-9]+)?(/[A-Za-z0-9._/-]*)?$ ]]; }
timestamp() { date --iso-8601=seconds; }
image_size_mib() { local bytes; bytes=$(stat -c%s -- "$1") || return; printf '%s\n' "$((bytes / 1048576))"; }
allocated_bytes() { local blocks; blocks=$(stat -c%b -- "$1") || return; printf '%s\n' "$((blocks * 512))"; }
human_bytes() { awk -v bytes="$1" 'BEGIN {split("B KiB MiB GiB TiB", u); i=1; while(bytes>=1024 && i<5){bytes/=1024; i++} printf "%.1f %s", bytes, u[i]}'; }

resolve_image() {
    valid_name "$1" || { fail "Invalid name: $1. Use 1-64 letters, digits, dots, underscores or hyphens; start with a letter or digit."; return 1; }
    local image="$IMAGE_DIR/$1.img"
    [[ -f $image && ! -L $image ]] || { fail "Chrootable not found (or is a symlink): $1"; return 1; }
    printf '%s\n' "$image"
}
unused_image() {
    valid_name "$1" || { fail "Invalid name: $1"; return 1; }
    [[ ! -e $IMAGE_DIR/$1.img && ! -L $IMAGE_DIR/$1.img ]] || { fail "A chrootable named '$1' already exists."; return 1; }
}
metadata_value() {
    local value= image=$1 key=$2 fallback=${3:-unknown} mkey mval
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            if [[ $mkey == "$key" ]]; then value=$mval; break; fi
        done <"$image.meta" || return
    fi
    printf '%s\n' "${value:-$fallback}"
}
image_lifecycle() {
    local lifecycle=persistent
    if [[ -f $1.meta ]]; then lifecycle=$(metadata_value "$1" lifecycle persistent)
    elif [[ -f $1.mode && ! -L $1.mode ]]; then read -r lifecycle <"$1.mode" || true; fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    printf '%s\n' "$lifecycle"
}
write_metadata() {
    local image=$1 temporary value
    for value in "${@:2}"; do
        [[ $value != *$'\n'* && $value != *$'\r'* ]] || return 1
    done
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if ! printf 'format=2\nlifecycle=%s\nsuite=%s\narchitecture=%s\nsize_mib=%s\ncreated_at=%s\nlast_used_at=%s\nprofile=%s\norigin=%s\n' \
        "$2" "$3" "$4" "$5" "$6" "$7" "${8:-minimal}" "${9:-none}" >"$temporary" ||
        ! mv -T -- "$temporary" "$image.meta"; then
        rm -f -- "$temporary"; return 1
    fi
}
metadata_set() {
    local image=$1 key=$2 value=$3 temporary line
    [[ $key =~ ^[a-z_]+$ && $value != *$'\n'* && $value != *$'\r'* ]] || return 1
    # Upgrade legacy .mode files before creating .meta, preserving their mode.
    if [[ ! -f $image.meta && -f $image ]]; then
        write_metadata "$image" "$(image_lifecycle "$image")" unknown unknown "$(image_size_mib "$image")" unknown never || return
    fi
    temporary=$(mktemp "$image.meta.XXXXXX") || return
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
            [[ ${line%%=*} == "$key" ]] || printf '%s\n' "$line"
        done <"$image.meta" >"$temporary" || { rm -f -- "$temporary"; return 1; }
    fi
    printf '%s=%s\n' "$key" "$value" >>"$temporary" && mv -T -- "$temporary" "$image.meta" || { rm -f -- "$temporary"; return 1; }
}
copy_metadata() {
    local source=$1 destination=$2 lifecycle=persistent suite=unknown architecture=unknown
    local created_at=unknown last_used_at=never profile=minimal origin=none mkey mval size_mib
    if [[ -f $source.meta && ! -L $source.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                origin) [[ -z $mval ]] || origin=$mval ;;
            esac
        done <"$source.meta"
    elif [[ -f $source.mode && ! -L $source.mode ]]; then
        read -r lifecycle <"$source.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    size_mib=$(image_size_mib "$source") || return
    write_metadata "$destination" "$lifecycle" "$suite" "$architecture" "$size_mib" \
        "${3:-$created_at}" "${4:-$last_used_at}" "$profile" "${5:-$origin}"
}

# Keep lock files after deletion: unlinking one would allow two processes to
# lock different inodes for the same name. Descriptors close on process exit.
lock_image() {
    local image=$1 new_fd
    [[ ! -L $image.lock ]] || { fail "Refusing a symlink lock: $image.lock"; return 1; }
    exec {new_fd}>>"$image.lock" || return
    if ! flock -n "$new_fd"; then
        exec {new_fd}>&-
        fail "This chrootable is already in use: $(basename "$image" .img)"; return 1
    fi
    printf -v "$2" '%s' "$new_fd"
}
image_status() {
    local descriptor
    if [[ -f $1.lock && ! -L $1.lock ]]; then
        if ! exec {descriptor}<"$1.lock"; then printf 'unknown'; return; fi
        if flock -n "$descriptor"; then printf 'ready'; else printf 'busy'; fi
        exec {descriptor}>&-
    else printf 'ready'; fi
}
assert_offline() {
    local devices
    [[ -f $1 && ! -L $1 ]] || { fail "Image disappeared or became a symlink: $1"; return 1; }
    devices=$(losetup -j "$1") || { fail "Could not check loop devices."; return 1; }
    [[ -z $devices ]] || { fail "Image is attached to a loop device. Unmount/detach it before continuing: $1"; return 1; }
}
snapshot_count() {
    local file count=0
    for file in "$SNAPSHOT_DIR/$1/"*.img; do [[ -f $file && ! -L $file ]] && count=$((count + 1)); done
    printf '%s' "$count"
}

package_for_command() {
    if command -v dnf >/dev/null 2>&1; then
        case $1 in
            whiptail) printf newt; return ;;
            ip) printf iproute; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gnupg2; return ;;
            xz) printf xz; return ;;
        esac
    elif command -v pacman >/dev/null 2>&1; then
        case $1 in
            whiptail) printf newt; return ;;
            ip) printf iproute2; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gnupg; return ;;
            hostname) printf inetutils; return ;;
            xz) printf xz; return ;;
        esac
    elif command -v zypper >/dev/null 2>&1; then
        case $1 in
            whiptail) printf newt; return ;;
            ip) printf iproute2; return ;;
            awk) printf gawk; return ;;
            gpgv) printf gpg2; return ;;
            hostname) printf hostname; return ;;
            xz) printf xz; return ;;
        esac
    fi
    case $1 in
        whiptail|debootstrap|dpkg|hostname|tar|gzip|gpgv|wget) printf '%s' "$1" ;;
        xz) printf xz-utils ;;
        mkfs.ext4|e2fsck|resize2fs) printf e2fsprogs ;;
        mount|umount|mountpoint|unshare|flock|losetup) printf util-linux ;;
        find) printf findutils ;;
        ip) printf iproute2 ;;
        awk) printf mawk ;;
        *) printf coreutils ;;
    esac
}
require_root() { [[ $EUID -eq 0 ]] || { fail "This operation needs root. Run with sudo."; return 1; }; }
check_prerequisites() {
    local command package existing; local -a packages=()
    require_root || return
    for command in "${REQUIRED_COMMANDS[@]}"; do
        [[ $command != whiptail || $NON_INTERACTIVE -eq 0 ]] || continue
        command -v "$command" >/dev/null 2>&1 && continue
        package=$(package_for_command "$command"); existing=" ${packages[*]} "
        [[ $existing == *" $package "* ]] || packages+=("$package")
    done
    if [[ ! -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then
        if command -v dnf >/dev/null 2>&1; then packages+=(debian-keyring)
        else packages+=(debian-archive-keyring); fi
    fi
    if (( ${#packages[@]} )); then
        [[ ${CHROOTABLE_AUTO_INSTALL:-1} != 0 ]] || { fail "Missing packages: ${packages[*]}. Install them or run --setup with CHROOTABLE_AUTO_INSTALL=1."; return 1; }
        local dep_log=${CHROOTABLE_DEP_LOG:-/var/log/chrootable-manager-dependencies.log}
        [[ ! -L $dep_log ]] || { fail "Refusing a symlink dependency log: $dep_log"; return 1; }
        info "Installing dependencies: ${packages[*]} (log: $dep_log)"
        if command -v dnf >/dev/null 2>&1; then
            dnf install -y --setopt=install_weak_deps=False "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v apt-get >/dev/null 2>&1; then
            apt-get update >>"$dep_log" 2>&1 &&
                DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v pacman >/dev/null 2>&1; then
            pacman -Sy --noconfirm --needed "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        elif command -v zypper >/dev/null 2>&1; then
            zypper --non-interactive refresh >>"$dep_log" 2>&1 &&
                zypper --non-interactive install "${packages[@]}" >>"$dep_log" 2>&1 || {
                fail "Dependency installation failed. See $dep_log"; return 1;
            }
        else
            fail "Install these packages first: ${packages[*]}"; return 1
        fi
    fi
}
init_store() {
    [[ $STORE_DIR == /* && $STORE_DIR != / ]] || { fail "CHROOTABLE_HOME must be an absolute directory other than /."; return 1; }
    STORE_DIR=$(readlink -m -- "$STORE_DIR") || return
    [[ $STORE_DIR != / ]] || { fail "The store cannot be /."; return 1; }
    configure_paths
    if [[ -e $STORE_DIR ]]; then
        local owner permissions
        read -r owner permissions < <(stat -c '%u %a' -- "$STORE_DIR") || return
        [[ $owner == "$EUID" ]] && (( (8#$permissions & 0022) == 0 )) || {
            fail "The store must be owned by the current user and not writable by group/others: $STORE_DIR"; return 1;
        }
    fi
    local directory
    for directory in "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR"; do
        [[ ! -L $directory ]] || { fail "Store subdirectories must not be symlinks: $directory"; return 1; }
    done
    [[ -d $STORE_DIR ]] || install -d -m 0700 "$STORE_DIR" || return
    [[ -d $IMAGE_DIR && -d $LOG_DIR && -d $EXPORT_DIR && -d $SNAPSHOT_DIR ]] ||
        install -d -m 0700 "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR"
}
check_readable_store() {
    [[ ! -e $STORE_DIR || ( -r $STORE_DIR && -x $STORE_DIR ) ]] || { fail "Store is not readable. Run with sudo to view $STORE_DIR"; return 1; }
}

record_event() {
    local descriptor
    exec {descriptor}>>"$STORE_DIR/.activity.lock" || return
    flock "$descriptor" || return
    printf '%s\t%s\t%s\t%s\t%s\n' "$(timestamp)" "$1" "$2" "$3" "$4" >>"$STORE_DIR/activity.tsv"
    exec {descriptor}>&-
}
begin_operation() {
    OPERATION=$1; OP_NAME=$2; PENDING=; WORK=
    OP_LOG=$(mktemp "$LOG_DIR/$2-$1-$(date +%Y%m%d-%H%M%S)-XXXXXX.log") || return
    printf '%s  %s  %s\n' "$(timestamp)" "$1" "$2" >>"$OP_LOG"
    trap finish_operation EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}
finish_operation() {
    local status=$?
    if [[ -n ${PENDING:-} ]]; then rm -f -- "$PENDING" "$PENDING.meta" || true; fi
    if [[ -n ${ARCHIVE_STAGING:-} ]]; then rm -rf --one-file-system -- "$ARCHIVE_STAGING" || true; fi
    if [[ -n ${WORK:-} ]]; then
        rm -f -- "$WORK/started" "$WORK/resolv.conf" "$WORK/resolv.conf.tmp" || true
        rmdir "$WORK/root" "$WORK/lower" "$WORK/overlay" "$WORK" 2>/dev/null || true
    fi
    if (( status == 0 )); then
        printf 'Completed: %s\n' "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" ok "$OP_LOG" || true
    else
        printf 'Failed with status %s: %s\n' "$status" "$(timestamp)" >>"$OP_LOG"
        record_event "$OPERATION" "$OP_NAME" failed "$OP_LOG" || true
        info "Operation failed (status $status). Log: $OP_LOG"
    fi
    return "$status"
}
make_workdir() { WORK=$(mktemp -d /run/chrootable-manager.XXXXXX); }
run_worker() { unshare --mount --uts --ipc --pid --fork --kill-child "$SCRIPT_PATH" --worker "$@"; }
publish_image() {
    local pending=$1 destination=$2
    mv -T -- "$pending.meta" "$destination.meta" || return
    mv -T -- "$pending" "$destination" || return
}

profile_packages() {
    case $1 in
        minimal) printf '' ;;
        build) printf 'build-essential git ca-certificates curl pkg-config' ;;
        python) printf 'python3 python3-venv python3-pip git ca-certificates curl' ;;
        network) printf 'iproute2 iputils-ping dnsutils curl ca-certificates openssh-client' ;;
        rust) printf 'rustc cargo git ca-certificates curl pkg-config' ;;
        go) printf 'golang-go git ca-certificates curl' ;;
        web) printf 'nodejs npm git ca-certificates curl' ;;
        *) return 1 ;;
    esac
}
list_profiles() {
    printf '%-12s %-9s %s\n' PROFILE SUGGESTED INCLUDES
    printf '%-12s %-9s %s\n' minimal '2 GiB' 'Debian minbase; a clean starting point' \
        build '4 GiB' 'C/C++ toolchain, make, Git, curl, pkg-config' \
        python '4 GiB' 'Python 3, venv, pip, Git, curl' \
        network '2 GiB' 'iproute2, ping, DNS tools, curl, SSH client' \
        rust '6 GiB' 'Rust toolchain, cargo, Git, curl, pkg-config' \
        go '6 GiB' 'Go toolchain, Git, curl' \
        web '4 GiB' 'Node.js, npm, Git, curl'
}

# -- Offline package archive -----------------------------------------------
#
# --archive-sync downloads everything a create needs into
# $ARCHIVE_DIR/<suite>-<arch>: a debootstrap --make-tarball of the minbase
# system, the Debian-signed apt lists it was resolved against, and the profile
# debs. Creates for that suite then run without a network. apt verifies each
# deb against the copied lists, so no store-local signing key is needed.

archive_path() { printf '%s/%s-%s' "$ARCHIVE_DIR" "$1" "$2"; }
archive_has_profile() {
    local archive=$1 profile=$2
    [[ ${CHROOTABLE_ARCHIVE:-1} != 0 && -s $archive/base.tgz && -s $archive/mirror ]] || return 1
    [[ $profile == minimal ]] || grep -qx -- "$profile" "$archive/profiles" 2>/dev/null
}
archive_sync() (
    # Rebuilds the suite's archive as a whole so the lists, base tarball and
    # debs always come from a single resolution.
    local suite=$1 arch archive profile
    shift
    local -a profiles=("$@")
    require_root || return
    valid_suite "$suite" || { fail "Invalid Debian suite: $suite"; return 1; }
    valid_mirror "$DEBIAN_MIRROR" || { fail "Debian mirror must be an https:// URL: $DEBIAN_MIRROR"; return 1; }
    (( ${#profiles[@]} )) || profiles=(build python network rust go web)
    for profile in "${profiles[@]}"; do
        valid_profile "$profile" || { fail "Unknown profile: $profile. See --profiles."; return 1; }
    done
    init_store || return
    [[ ! -L $ARCHIVE_DIR ]] || { fail "Store subdirectories must not be symlinks: $ARCHIVE_DIR"; return 1; }
    [[ -d $ARCHIVE_DIR ]] || install -d -m 0700 "$ARCHIVE_DIR" || return
    arch=$(dpkg --print-architecture) || return
    archive=$(archive_path "$suite" "$arch")
    begin_operation archive "$suite" || return
    make_workdir || return
    ARCHIVE_STAGING=$(mktemp -d "$ARCHIVE_DIR/.$suite-$arch.XXXXXX") || return
    info "Downloading Debian $suite ($arch) packages for: minimal ${profiles[*]}. Log: $OP_LOG"
    mkdir -p "$ARCHIVE_STAGING/scratch" "$ARCHIVE_STAGING/debs" "$ARCHIVE_STAGING/lists" || return
    # apt downloads as _apt, which must be able to traverse the scratch root.
    chmod 0755 "$ARCHIVE_STAGING/scratch" || return
    run_worker archive "$ARCHIVE_STAGING/scratch" "$WORK" "$suite" "$arch" "$ARCHIVE_STAGING" "${profiles[@]}" >>"$OP_LOG" 2>&1 || return
    rm -rf --one-file-system -- "$ARCHIVE_STAGING/scratch" || return
    printf '%s\n' "$DEBIAN_MIRROR" >"$ARCHIVE_STAGING/mirror" || return
    printf '%s\n' "${profiles[@]}" >"$ARCHIVE_STAGING/profiles" || return
    if [[ -e $archive ]]; then
        mv -T -- "$archive" "$ARCHIVE_STAGING.old" || return
    fi
    mv -T -- "$ARCHIVE_STAGING" "$archive" || return
    ARCHIVE_STAGING="$ARCHIVE_STAGING.old"
    rm -rf --one-file-system -- "$ARCHIVE_STAGING" || return
    ARCHIVE_STAGING=
    info "Archive ready: $archive ($(du -sh -- "$archive" | cut -f1)). Creates for $suite now work offline."
)
archive_worker() {
    # Runs inside run_worker's namespaces; WORKER_ROOT is a bind of the scratch
    # directory so worker_cleanup unmounts everything beneath it.
    local scratch=$1 suite=$2 arch=$3 staging=$4 profile
    shift 4
    local -a package_list=()
    mount --bind "$scratch" "$WORKER_ROOT" || return
    SHA_SIZE=256 debootstrap --force-check-gpg --keyring=/usr/share/keyrings/debian-archive-keyring.gpg \
        --variant=minbase --arch="$arch" --make-tarball="$staging/base.tgz" \
        "$suite" "$staging/tarball-work" "$DEBIAN_MIRROR" || return
    rm -rf --one-file-system -- "$staging/tarball-work" || return
    # Unpack the tarball just written: this proves it bootstraps, and resolves
    # profile dependencies against exactly the base a create will have.
    debootstrap --variant=minbase --arch="$arch" --unpack-tarball="$staging/base.tgz" "$suite" "$WORKER_ROOT" || return
    printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$suite" >"$WORKER_ROOT/etc/apt/sources.list" || return
    setup_resolv_conf "$work" "$WORKER_ROOT"
    mount_session_devices || return
    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get update || return
    for profile in "$@"; do
        read -r -a package_list <<<"$(profile_packages "$profile")"
        (( ${#package_list[@]} )) || continue
        chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get \
            --download-only -y --no-install-recommends install "${package_list[@]}" || {
            fail "Downloading profile $profile failed."; return 1;
        }
    done
    find "$WORKER_ROOT/var/cache/apt/archives" -maxdepth 1 -type f -name '*.deb' \
        -exec cp -p -t "$staging/debs" -- {} + || return
    find "$WORKER_ROOT/var/lib/apt/lists" -maxdepth 1 -type f ! -name lock \
        -exec cp -p -t "$staging/lists" -- {} + || return
}
archive_install_profile() {
    # Offline profile install: Debian-signed lists from the archive, debs read
    # through an overlay so apt's lock and partial files never touch the store.
    local archive=$1 mirror
    shift
    mirror=$(<"$archive/mirror") || return
    valid_mirror "$mirror" || { fail "Archive records an invalid mirror."; return 1; }
    # Lists are only used when sources.list names the mirror they came from.
    printf 'deb %s %s main\n' "$mirror" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list" || return
    find "$archive/lists" -maxdepth 1 -type f -exec cp -p -t "$WORKER_ROOT/var/lib/apt/lists" -- {} + || return
    mkdir -p "$WORKER_OVERLAY/upper" "$WORKER_OVERLAY/work" || return
    mount -t overlay overlay -o "lowerdir=$archive/debs,upperdir=$WORKER_OVERLAY/upper,workdir=$WORKER_OVERLAY/work" \
        "$WORKER_ROOT/var/cache/apt/archives" || return
    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get \
        --no-download -y --no-install-recommends install "$@" || return
    umount "$WORKER_ROOT/var/cache/apt/archives" || return
    printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list"
}

allocate_image() {
    local target=$1 size_mib=$2
    if truncate -s "${size_mib}M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    elif command -v fallocate >/dev/null 2>&1 && fallocate -l "${size_mib}M" "$target" >>"$OP_LOG" 2>&1; then
        return 0
    fi
    dd if=/dev/zero of="$target" bs=1M count="$size_mib" status=none conv=fsync >>"$OP_LOG" 2>&1
}

create_image() (
    local name=$1 size=$2 lifecycle=$3 profile=${4:-minimal} image descriptor arch
    unused_image "$name" || return
    valid_size_mib "$size" || { fail "Size must be a whole number from 1 to 1048576 MiB."; return 1; }
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    valid_profile "$profile" || { fail "Unknown profile: $profile. See --profiles."; return 1; }
    valid_suite "$DEBIAN_SUITE" || { fail "Invalid Debian suite: $DEBIAN_SUITE"; return 1; }
    valid_mirror "$DEBIAN_MIRROR" || { fail "Debian mirror must be an https:// URL: $DEBIAN_MIRROR"; return 1; }
    image="$IMAGE_DIR/$name.img"
    lock_image "$image" descriptor || return
    unused_image "$name" || return
    local available
    { read -r _; read -r _ _ _ available _; } < <(df -PB1 "$STORE_DIR") || return
    (( available >= size * 1048576 )) || { fail "Not enough free space for a ${size} MiB image."; return 1; }
    begin_operation create "$name" || return
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    make_workdir || return
    arch=$(dpkg --print-architecture) || return
    info "Creating $name / Debian $DEBIAN_SUITE / $profile / $size MiB. Log: $OP_LOG"
    allocate_image "$PENDING" "$size" || return
    mkfs.ext4 -F -L "${name:0:16}" "$PENDING" >>"$OP_LOG" 2>&1 || return
    run_worker create "$PENDING" "$WORK" "$name" "$arch" "$profile" >>"$OP_LOG" 2>&1 || return
    write_metadata "$PENDING" "$lifecycle" "$DEBIAN_SUITE" "$arch" "$size" "$(timestamp)" never "$profile" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Created '$name'. Enter with: sudo $0 --enter $name"
)
clone_image() (
    local source=$1 name=$2 descriptor destination_lock destination source_name
    unused_image "$name" || return
    lock_image "$source" descriptor || return
    assert_offline "$source" || return
    destination="$IMAGE_DIR/$name.img"
    lock_image "$destination" destination_lock || return
    unused_image "$name" || return
    source_name=${source##*/}; source_name=${source_name%.img}
    begin_operation clone "$source_name" || return
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    cp --reflink=auto --sparse=always -- "$source" "$PENDING" >>"$OP_LOG" 2>&1 || return
    copy_metadata "$source" "$PENDING" "$(timestamp)" never "$source_name" || return
    publish_image "$PENDING" "$destination" || return
    PENDING=
    info "Created clone '$name'."
)
fsck_preflight() {
    local status=0
    e2fsck -f -p "$1" >>"$2" 2>&1 || status=$?
    (( status <= 1 ))
}
resize_image() (
    local image=$1 requested=$2 current descriptor
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    # Capacity can change before the lock is acquired; never truncate using a
    # stale expansion check after another resize has already finished.
    current=$(image_size_mib "$image") || return
    valid_size_mib "$requested" && (( requested > current )) || { fail "Choose a size larger than $current MiB (maximum 1048576)."; return 1; }
    begin_operation resize "$(basename "$image" .img)" || return
    fsck_preflight "$image" "$OP_LOG" || return
    truncate -s "${requested}M" "$image" >>"$OP_LOG" 2>&1 || return
    resize2fs "$image" >>"$OP_LOG" 2>&1 || return
    metadata_set "$image" size_mib "$requested" || return
    info "Expanded '$(basename "$image" .img)' to $requested MiB."
)
repair_image() (
    local image=$1 descriptor status=0
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation repair "$(basename "$image" .img)" || return
    e2fsck -f -y "$image" >>"$OP_LOG" 2>&1 || status=$?
    (( status <= 1 )) || return "$status"
    info "Filesystem repair completed. Log: $OP_LOG"
)
export_image() (
    local image=$1 name descriptor archive token
    name=$(basename "$image" .img)
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation export "$name" || return
    make_workdir || return
    PENDING=$(mktemp "$EXPORT_DIR/.$name.XXXXXX.partial") || return
    token=${PENDING%.partial}; token=${token##*.}
    archive="$EXPORT_DIR/$name-$(date +%Y%m%d-%H%M%S)-$token.tar.gz"
    run_worker export "$image" "$WORK" "$PENDING" >>"$OP_LOG" 2>&1 || return
    mv -T -- "$PENDING" "$archive" || return
    PENDING=
    printf '%s\n' "$archive"
)
set_lifecycle() (
    local image=$1 lifecycle=$2 descriptor
    valid_lifecycle "$lifecycle" || { fail "Lifecycle must be persistent or ephemeral."; return 1; }
    lock_image "$image" descriptor || return
    begin_operation mode "$(basename "$image" .img)" || return
    metadata_set "$image" lifecycle "$lifecycle" || return
    info "'$(basename "$image" .img)' now uses $lifecycle sessions."
)
delete_image() (
    local image=$1 descriptor
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation delete "$(basename "$image" .img)" || return
    rm -f -- "$image" "$image.meta" "$image.mode" || return
    info "Deleted '$(basename "$image" .img)'. Snapshots and exports were retained."
)

snapshot_path() {
    valid_name "$1" && valid_name "$2" || { fail "Invalid image name or snapshot label."; return 1; }
    [[ ! -L $SNAPSHOT_DIR/$1 ]] || { fail "Snapshot directories must not be symlinks."; return 1; }
    printf '%s/%s/%s.img\n' "$SNAPSHOT_DIR" "$1" "$2"
}
# Caller holds the image lock throughout snapshot/restore, including copies.
save_snapshot_locked() {
    local image=$1 label=$2 name destination
    name=$(basename "$image" .img)
    destination=$(snapshot_path "$name" "$label") || return
    [[ ! -e $destination && ! -L $destination ]] || { fail "Snapshot '$label' already exists."; return 1; }
    install -d -m 0700 "$SNAPSHOT_DIR/$name" || return
    PENDING=$(mktemp "$SNAPSHOT_DIR/$name/.$label.XXXXXX.partial") || return
    cp --reflink=auto --sparse=always -- "$image" "$PENDING" >>"$OP_LOG" 2>&1 || return
    copy_metadata "$image" "$PENDING" || return
    metadata_set "$PENDING" snapshot_at "$(timestamp)" || return
    publish_image "$PENDING" "$destination" || return
    PENDING=
    info "Saved snapshot '$label' for '$name'."
}
snapshot_image() (
    local image=$1 label=$2 descriptor
    valid_name "$label" || { fail "Invalid snapshot label."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation snapshot "$(basename "$image" .img)" || return
    save_snapshot_locked "$image" "$label"
)
restore_image() (
    local name=$1 label=$2 image snapshot descriptor recovery
    snapshot=$(snapshot_path "$name" "$label") || return
    [[ -f $snapshot && ! -L $snapshot ]] || { fail "Snapshot not found: $name / $label"; return 1; }
    image="$IMAGE_DIR/$name.img"
    [[ ! -L $image ]] || { fail "Refusing a symlink image."; return 1; }
    lock_image "$image" descriptor || return
    assert_offline "$snapshot" || return
    if [[ -e $image ]]; then assert_offline "$image" || return; fi
    begin_operation restore "$name" || return
    if [[ -f $image ]]; then
        recovery="before-restore-$(date +%Y%m%d-%H%M%S)-$BASHPID"
        save_snapshot_locked "$image" "$recovery" || return
    fi
    PENDING=$(mktemp "$IMAGE_DIR/.$name.XXXXXX.partial") || return
    cp --reflink=auto --sparse=always -- "$snapshot" "$PENDING" >>"$OP_LOG" 2>&1 || return
    copy_metadata "$snapshot" "$PENDING" || return
    publish_image "$PENDING" "$image" || return
    PENDING=
    info "Restored '$name' from '$label'."
    [[ -z ${recovery:-} ]] || info "Undo this restore with: $0 --restore $name $recovery --yes"
)
drop_snapshot() (
    local name=$1 label=$2 snapshot descriptor
    snapshot=$(snapshot_path "$name" "$label") || return
    lock_image "$IMAGE_DIR/$name.img" descriptor || return
    assert_offline "$snapshot" || return
    begin_operation drop-snapshot "$name" || return
    rm -f -- "$snapshot" "$snapshot.meta" || return
    info "Deleted snapshot '$name / $label'."
)
list_snapshots() {
    local name=$1 snapshot snap_name bytes stat_output idx=0
    local -a valid_snaps=() stat_lines=()
    valid_name "$name" || { fail "Invalid image name."; return 1; }
    for snapshot in "$SNAPSHOT_DIR/$name/"*.img; do
        [[ -f $snapshot && ! -L $snapshot ]] || continue
        valid_snaps+=("$snapshot")
    done
    if (( ${#valid_snaps[@]} )); then
        stat_output=$(stat -c '%s' -- "${valid_snaps[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    for snapshot in "${valid_snaps[@]}"; do
        snap_name=${snapshot##*/}; snap_name=${snap_name%.img}
        bytes=${stat_lines[$idx]:-0}; idx=$((idx + 1))
        printf '%s\t%s MiB\t%s\n' "$snap_name" "$((bytes / 1048576))" "$(metadata_value "$snapshot" snapshot_at unknown)"
    done
}

enter_chrootable() (
    local image=$1 lifecycle=$2 network=$3 share=$4 read_only=$5 descriptor status=0 name
    shift 5
    if [[ -n $share ]]; then canonicalize_shared_folder "$share" share || return; fi
    [[ $read_only == 0 || ( $read_only == 1 && -n $share ) ]] || { fail "Read-only sharing requires a host folder."; return 1; }
    export CHROOTABLE_RESTRICTED_DEV="${SESSION_RESTRICTED_DEV:-0}"
    name=$(basename "$image" .img)
    lock_image "$image" descriptor || return
    assert_offline "$image" || return
    begin_operation session "$name" || return
    make_workdir || return
    local -a namespace=(--mount --uts --ipc --pid --fork --kill-child)
    [[ $network != isolated ]] || namespace+=(--net)
    unshare "${namespace[@]}" "$SCRIPT_PATH" --worker enter "$image" "$WORK" "$name" "$lifecycle" "$network" "$share" "$read_only" "$@" || status=$?
    # A worker marker distinguishes a guest command failure from mount failure.
    if [[ -f $WORK/started ]]; then
        metadata_set "$image" last_used_at "$(timestamp)" || return
        rm -f -- "$WORK/started" || return
    fi
    return "$status"
)
worker_cleanup() {
    local status=$? cleanup_status=0
    cd / || true
    kill -TERM -1 2>/dev/null || true
    sleep 0.05 2>/dev/null || true
    kill -KILL -1 2>/dev/null || true
    if [[ -n ${WORKER_SHARE_TARGET:-} ]]; then
        if mountpoint -q "$WORKER_SHARE_TARGET"; then
            umount -- "$WORKER_SHARE_TARGET" 2>/dev/null || cleanup_status=$?
        fi
        if [[ ${WORKER_SHARE_CREATED:-0} == 1 && ! -L $WORKER_SHARE_TARGET ]] && ! mountpoint -q "$WORKER_SHARE_TARGET"; then
            rmdir -- "$WORKER_SHARE_TARGET" 2>/dev/null || true
        fi
    fi
    if mountpoint -q "$WORKER_ROOT/etc/resolv.conf"; then umount "$WORKER_ROOT/etc/resolv.conf" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT/dev/ptmx"; then umount "$WORKER_ROOT/dev/ptmx" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT/dev/pts"; then umount "$WORKER_ROOT/dev/pts" 2>/dev/null || true; fi
    if mountpoint -q "$WORKER_ROOT"; then umount -R "$WORKER_ROOT" 2>/dev/null || umount -l "$WORKER_ROOT" || cleanup_status=$?; fi
    if mountpoint -q "$WORKER_LOWER"; then umount "$WORKER_LOWER" 2>/dev/null || umount -l "$WORKER_LOWER" || cleanup_status=$?; fi
    if mountpoint -q "$WORKER_OVERLAY"; then umount "$WORKER_OVERLAY" 2>/dev/null || umount -l "$WORKER_OVERLAY" || cleanup_status=$?; fi
    (( status != 0 || cleanup_status == 0 )) || status=$cleanup_status
    exit "$status"
}
setup_resolv_conf() {
    local work=$1 root=$2 source_file=""
    local target="$root/etc/resolv.conf" dest="$work/resolv.conf"

    if [[ -f /run/systemd/resolve/resolv.conf && -r /run/systemd/resolve/resolv.conf ]]; then
        source_file="/run/systemd/resolve/resolv.conf"
    elif [[ -f /etc/resolv.conf && -r /etc/resolv.conf ]]; then
        source_file="/etc/resolv.conf"
    fi

    if [[ -n $source_file && -f $source_file ]]; then
        cp -L "$source_file" "$dest" 2>/dev/null || true
    fi

    if [[ -f $dest ]] && grep -qE '^[[:space:]]*nameserver[[:space:]]+127\.' "$dest" 2>/dev/null; then
        awk '!/^[[:space:]]*nameserver[[:space:]]+127\./' "$dest" >"$dest.tmp" 2>/dev/null && mv -f -- "$dest.tmp" "$dest" || true
        if ! grep -qE '^[[:space:]]*nameserver[[:space:]]+' "$dest" 2>/dev/null; then
            printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >>"$dest"
        fi
    elif [[ ! -f $dest || ! -s $dest ]]; then
        printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >"$dest"
    fi

    # The manager uses umask 077, but apt downloads as the unprivileged _apt
    # account. Its resolver must stay readable after being bound into the guest.
    chmod 0644 "$dest" || return

    if [[ -d $root/etc ]]; then
        touch "$target" 2>/dev/null || true
        mount --bind "$dest" "$target" 2>/dev/null || true
        mount --make-rslave "$target" 2>/dev/null || true
    fi
}
mount_session_devices() {
    mkdir -p "$WORKER_ROOT/proc" "$WORKER_ROOT/dev" "$WORKER_ROOT/run" || return
    mount -t proc proc "$WORKER_ROOT/proc" || return
    mount --rbind /dev "$WORKER_ROOT/dev" || return
    mount --make-rslave "$WORKER_ROOT/dev" || return
    if mkdir -p "$WORKER_ROOT/dev/pts" 2>/dev/null; then
        mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$WORKER_ROOT/dev/pts" 2>/dev/null &&
            mount --bind "$WORKER_ROOT/dev/pts/ptmx" "$WORKER_ROOT/dev/ptmx" 2>/dev/null || true
    fi
    mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$WORKER_ROOT/run"
}
mount_restricted_devices() {
    # Opt-in reduced /dev: a fresh tmpfs with only the character devices a
    # Debian shell needs. No host device nodes are exposed.
    local dev="$WORKER_ROOT/dev"
    mkdir -p "$dev/pts" || return
    mount -t tmpfs -o mode=0755,nosuid tmpfs "$dev" || return
    mount -t devpts -o newinstance,ptmxmode=0666,mode=0620 devpts "$dev/pts" || return
    ln -s pts/ptmx "$dev/ptmx" || return
    ln -s /proc/self/fd "$dev/fd" && ln -s /proc/self/fd/0 "$dev/stdin" &&
        ln -s /proc/self/fd/1 "$dev/stdout" && ln -s /proc/self/fd/2 "$dev/stderr" || return
    mknod -m 666 "$dev/null" c 1 3 && mknod -m 666 "$dev/zero" c 1 5 &&
        mknod -m 666 "$dev/full" c 1 7 && mknod -m 444 "$dev/random" c 1 8 &&
        mknod -m 666 "$dev/urandom" c 1 9 && mknod -m 666 "$dev/tty" c 5 0 || return
}
canonicalize_shared_folder() {
    local original=$1 resolved
    [[ $original == /* ]] || { fail "Shared folder must be an absolute host directory."; return 1; }
    [[ $original != *$'\n'* && $original != *$'\r'* ]] || { fail "Shared folder paths cannot contain line breaks."; return 1; }
    # NUL termination prevents line breaks from being silently trimmed.
    IFS= read -r -d '' resolved < <(readlink -ez -- "$original") || { fail "Shared folder does not exist: $original"; return 1; }
    [[ $resolved != / && -d $resolved ]] || { fail "Shared folder must be an existing directory other than /."; return 1; }
    [[ $resolved != *$'\n'* && $resolved != *$'\r'* ]] || { fail "Shared folder paths cannot contain line breaks."; return 1; }
    printf -v "$2" '%s' "$resolved"
}
mount_shared_folder() {
    local source=$1 read_only=$2 target="$WORKER_ROOT/shared"
    [[ -n $source ]] || return 0
    canonicalize_shared_folder "$source" source || return
    # /shared is a direct child of the image root: never follow a guest symlink
    # into the host namespace or replace a file already stored in the image.
    [[ ! -L $target && ( ! -e $target || -d $target ) ]] || { fail "Guest /shared must be a directory, not a symlink or file."; return 1; }
    WORKER_SHARE_CREATED=0
    if [[ ! -d $target ]]; then
        mkdir -- "$target" || return
        WORKER_SHARE_CREATED=1
    fi
    WORKER_SHARE_TARGET=$target
    # A plain bind excludes submounts within the source folder.
    mount --bind -- "$source" "$target" || return
    if [[ $read_only == 1 ]]; then mount -o remount,bind,ro -- "$target" || return; fi
}
worker_main() (
    local kind=$1 image=$2 work=$3
    shift 3
    require_root || return
    WORKER_ROOT="$work/root"; WORKER_LOWER="$work/lower"; WORKER_OVERLAY="$work/overlay"
    WORKER_SHARE_TARGET=; WORKER_SHARE_CREATED=0
    trap worker_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    mount --make-rprivate / || return
    mkdir -p "$WORKER_ROOT" || return
    case $kind in
        create)
            local name=$1 arch=$2 profile=$3 packages archive offline=0
            valid_suite "$DEBIAN_SUITE" && valid_mirror "$DEBIAN_MIRROR" || { fail "Invalid Debian suite or mirror."; return 1; }
            archive=$(archive_path "$DEBIAN_SUITE" "$arch")
            mount -o loop "$image" "$WORKER_ROOT" || return
            if archive_has_profile "$archive" minimal; then
                info "Bootstrapping from the offline archive: $archive"
                debootstrap --variant=minbase --arch="$arch" --unpack-tarball="$archive/base.tgz" "$DEBIAN_SUITE" "$WORKER_ROOT" || return
                ! archive_has_profile "$archive" "$profile" || offline=1
            else
                SHA_SIZE=256 debootstrap --force-check-gpg --keyring=/usr/share/keyrings/debian-archive-keyring.gpg --variant=minbase --arch="$arch" "$DEBIAN_SUITE" "$WORKER_ROOT" "$DEBIAN_MIRROR" || return
            fi
            printf 'deb %s %s main\n' "$DEBIAN_MIRROR" "$DEBIAN_SUITE" >"$WORKER_ROOT/etc/apt/sources.list" || return
            printf '%s\n' "$name" >"$WORKER_ROOT/etc/hostname" || return
            printf '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' "$name" >"$WORKER_ROOT/etc/hosts" || return
            packages=$(profile_packages "$profile") || return
            if [[ -n $packages ]]; then
                local -a package_list=()
                read -r -a package_list <<<"$packages"
                if (( offline )); then
                    info "Installing the $profile profile from the offline archive."
                    mount_session_devices || return
                    mkdir -p "$WORKER_OVERLAY" || return
                    mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs "$WORKER_OVERLAY" || return
                    archive_install_profile "$archive" "${package_list[@]}" || return
                else
                    setup_resolv_conf "$work" "$WORKER_ROOT"
                    mount_session_devices || return
                    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get update || return
                    chroot "$WORKER_ROOT" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${package_list[@]}" || return
                fi
            fi
            chroot "$WORKER_ROOT" apt-get clean || return
            ;;
        archive) archive_worker "$image" "$@" || return ;;
        export)
            mount -o loop,ro,noload "$image" "$WORKER_ROOT" || return
            tar --numeric-owner --acls --xattrs --one-file-system -C "$WORKER_ROOT" -czf "$1" . || return
            ;;
        enter)
            local name=$1 lifecycle=$2 network=$3 share=$4 read_only=$5
            shift 5
            if [[ $lifecycle == ephemeral ]]; then
                mkdir -p "$WORKER_LOWER" "$WORKER_OVERLAY" || return
                mount -o loop,ro,noload "$image" "$WORKER_LOWER" || return
                mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs "$WORKER_OVERLAY" || return
                mkdir -p "$WORKER_OVERLAY/upper" "$WORKER_OVERLAY/work" || return
                mount -t overlay overlay -o "lowerdir=$WORKER_LOWER,upperdir=$WORKER_OVERLAY/upper,workdir=$WORKER_OVERLAY/work" "$WORKER_ROOT" || return
            else
                mount -o loop "$image" "$WORKER_ROOT" || return
            fi
            if [[ $network == isolated ]]; then
                ip link set lo up 2>/dev/null || ifconfig lo up 2>/dev/null || true
            else
                setup_resolv_conf "$work" "$WORKER_ROOT"
            fi
            if [[ ${CHROOTABLE_RESTRICTED_DEV:-0} == 1 ]]; then
                mount_restricted_devices || return
            else
                mount_session_devices || return
            fi
            mount_shared_folder "$share" "$read_only" || return
            hostname "$name" || return
            printf 'started\n' >"$work/started" || return
            # Scripts get exactly the command's stdout; the banner is shell-only.
            if (( $# == 0 )); then
                info "[$name] $lifecycle session | network: $network"
                [[ $lifecycle != ephemeral ]] || info "Image filesystem changes in this session disappear on exit."
                if [[ -n $share ]]; then
                    info "Host folder: $share -> /shared"
                    if [[ $read_only == 1 ]]; then info "/shared is read-only."; else info "Changes in /shared are saved on the host, including in disposable sessions."; fi
                fi
                set -- /bin/bash --login
            fi
            cd "$WORKER_ROOT" || return
            chroot "$WORKER_ROOT" /usr/bin/env -i HOME=/root USER=root LOGNAME=root \
                LANG="${LANG:-C.UTF-8}" TERM="${TERM:-xterm}" \
                PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
                CHROOTABLE_NAME="$name" CHROOTABLE_LIFECYCLE="$lifecycle" CHROOTABLE_NETWORK="$network" \
                "$@" || return
            cd / || return
            ;;
        *) fail "Unknown worker operation."; return 2 ;;
    esac
)

# JSON output needs no Python/jq dependency and never evaluates metadata.
json_string() {
    local value=$1 character number i
    if [[ $value != *[\"\\$'\001'-$'\037']* ]]; then
        printf '"%s"' "$value"
        return
    fi
    printf '"'
    for ((i=0; i<${#value}; i++)); do
        character=${value:i:1}
        case $character in
            '"') printf '\\"' ;; \\) printf '\\\\' ;;
            *) printf -v number '%d' "'$character"
               if (( number < 32 )); then printf '\\u%04x' "$number"; else printf '%s' "$character"; fi ;;
        esac
    done
    printf '"'
}
image_json() {
    local image=$1 bytes=${2:-} blocks=${3:-} name key value comma= status=ready lifecycle=persistent suite=unknown architecture=unknown
    local profile=minimal created_at=unknown last_used_at=never origin=unknown mkey mval snaps=0 file
    name=${image##*/}; name=${name%.img}
    if [[ -f $image.lock && ! -L $image.lock ]]; then
        status=$(image_status "$image")
    fi
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
                origin) [[ -z $mval ]] || origin=$mval ;;
            esac
        done <"$image.meta"
    elif [[ -f $image.mode && ! -L $image.mode ]]; then
        read -r lifecycle <"$image.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    if [[ -z $bytes || -z $blocks ]]; then
        read -r bytes blocks < <(stat -c '%s %b' -- "$image") || return
    fi
    for file in "$SNAPSHOT_DIR/$name/"*.img; do [[ -f $file && ! -L $file ]] && snaps=$((snaps + 1)); done
    printf '{'
    for key in name path status lifecycle suite architecture profile created_at last_used_at origin; do
        case $key in
            name) value=$name ;; path) value=$image ;; status) value=$status ;;
            lifecycle) value=$lifecycle ;; suite) value=$suite ;; architecture) value=$architecture ;;
            profile) value=$profile ;; created_at) value=$created_at ;; last_used_at) value=$last_used_at ;;
            origin) value=$origin ;;
        esac
        printf '%s"%s":' "$comma" "$key"; json_string "$value"; comma=,
    done
    printf ',"size_mib":%s,"allocated_bytes":%s,"snapshots":%s}' "$((bytes / 1048576))" "$((blocks * 512))" "$snaps"
}
list_images() {
    local format=${1:-text} image name comma= idx=0 bytes blocks stat_output
    local -a valid_images=() stat_lines=()
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        name=${image##*/}; name=${name%.img}
        valid_name "$name" || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%s %b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    [[ $format != json ]] || printf '['
    for image in "${valid_images[@]}"; do
        name=${image##*/}; name=${name%.img}
        read -r bytes blocks <<<"${stat_lines[$idx]:-0 0}"
        idx=$((idx + 1))
        if [[ $format == json ]]; then printf '%s' "$comma"; image_json "$image" "$bytes" "$blocks"; comma=,
        else printf '%s\t%s\t%s MiB\n' "$name" "$(image_lifecycle "$image")" "$((bytes / 1048576))"; fi
    done
    [[ $format != json ]] || printf ']\n'
    return 0
}
image_details() {
    local image=$1 name status=ready lifecycle=persistent suite=unknown architecture=unknown
    local profile=minimal created_at='unknown (legacy image)' last_used_at=never mkey mval bytes=0 blocks=0
    name=${image##*/}; name=${name%.img}
    if [[ -f $image.lock && ! -L $image.lock ]]; then status=$(image_status "$image"); fi
    if [[ -f $image.meta && ! -L $image.meta ]]; then
        while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
            case $mkey in
                lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                suite) [[ -z $mval ]] || suite=$mval ;;
                architecture) [[ -z $mval ]] || architecture=$mval ;;
                profile) [[ -z $mval ]] || profile=$mval ;;
                created_at) [[ -z $mval ]] || created_at=$mval ;;
                last_used_at) [[ -z $mval ]] || last_used_at=$mval ;;
            esac
        done <"$image.meta"
    elif [[ -f $image.mode && ! -L $image.mode ]]; then
        read -r lifecycle <"$image.mode" || true
    fi
    valid_lifecycle "$lifecycle" || lifecycle=persistent
    read -r bytes blocks < <(stat -c '%s %b' -- "$image") || return
    printf '%s  /  %s  /  %s\n' "$name" "$status" "$lifecycle"
    printf '\nDebian %-14s Architecture %s\nProfile %-13s Snapshots    %s\n' \
        "$suite" "$architecture" "$profile" "$(snapshot_count "$name")"
    printf 'Capacity %s MiB   Allocated %s\nCreated  %s\nLast run %s\nImage    %s\n' \
        "$((bytes / 1048576))" "$(human_bytes "$((blocks * 512))")" \
        "$created_at" "$last_used_at" "$image"
}
workspace_summary() {
    local image total=0 persistent=0 ephemeral=0 busy=0 bytes=0 snapshots=0 free=unknown lifecycle mkey mval blocks stat_output
    local -a valid_images=() stat_lines=()
    local idx=0
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    for image in "${valid_images[@]}"; do
        blocks=${stat_lines[$idx]:-0}; idx=$((idx + 1))
        total=$((total + 1)); bytes=$((bytes + blocks * 512))
        lifecycle=persistent
        if [[ -f $image.meta && ! -L $image.meta ]]; then
            while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
                [[ $mkey == lifecycle && -n $mval ]] && { lifecycle=$mval; break; }
            done <"$image.meta"
        elif [[ -f $image.mode && ! -L $image.mode ]]; then
            read -r lifecycle <"$image.mode" || true
        fi
        valid_lifecycle "$lifecycle" || lifecycle=persistent
        if [[ $lifecycle == ephemeral ]]; then ephemeral=$((ephemeral + 1)); else persistent=$((persistent + 1)); fi
        if [[ -f $image.lock && ! -L $image.lock ]] && [[ $(image_status "$image") == busy ]]; then
            busy=$((busy + 1))
        fi
    done
    for image in "$SNAPSHOT_DIR/"*/*.img; do [[ ! -f $image || -L $image ]] || snapshots=$((snapshots + 1)); done
    if [[ -d $STORE_DIR ]]; then { read -r _; read -r _ _ _ free _; } < <(df -Ph "$STORE_DIR") || free=unknown; fi
    printf '%s workspaces   %s persistent   %s disposable   %s busy\n' "$total" "$persistent" "$ephemeral" "$busy"
    printf '%s in images   %s host free   %s snapshots\n' "$(human_bytes "$bytes")" "$free" "$snapshots"
}
dashboard() {
    local image name status lifecycle profile mkey mval snaps file bytes blocks stat_output idx=0 accent= reset=
    local total=0 persistent=0 ephemeral=0 busy=0 allocated=0 snapshots=0 free=unknown row
    local -a valid_images=() stat_lines=() rows=()
    if [[ -t 1 && -z ${NO_COLOR:-} ]]; then accent=$'\033[1;36m'; reset=$'\033[0m'; fi
    printf '\n%sCHROOTABLE%s  /  Debian environment workbench  /  %s\n\n' "$accent" "$reset" "$APP_VERSION"
    for image in "$IMAGE_DIR/"*.img; do
        [[ -f $image && ! -L $image ]] || continue
        valid_images+=("$image")
    done
    if (( ${#valid_images[@]} )); then
        stat_output=$(stat -c '%s %b' -- "${valid_images[@]}") || return
        mapfile -t stat_lines <<<"$stat_output"
    fi
    for image in "${valid_images[@]}"; do
        name=${image##*/}; name=${name%.img}
        read -r bytes blocks <<<"${stat_lines[$idx]:-0 0}"; idx=$((idx + 1))
        total=$((total + 1)); allocated=$((allocated + blocks * 512))
        status=ready
        if [[ -f $image.lock && ! -L $image.lock ]]; then
            status=$(image_status "$image")
            [[ $status != busy ]] || busy=$((busy + 1))
        fi
        lifecycle=persistent; profile=minimal
        if [[ -f $image.meta && ! -L $image.meta ]]; then
            while IFS='=' read -r mkey mval || [[ -n $mkey || -n $mval ]]; do
                case $mkey in
                    lifecycle) [[ -z $mval ]] || lifecycle=$mval ;;
                    profile) [[ -z $mval ]] || profile=$mval ;;
                esac
            done <"$image.meta"
        elif [[ -f $image.mode && ! -L $image.mode ]]; then
            read -r lifecycle <"$image.mode" || true
        fi
        valid_lifecycle "$lifecycle" || lifecycle=persistent
        if [[ $lifecycle == ephemeral ]]; then ephemeral=$((ephemeral + 1)); else persistent=$((persistent + 1)); fi
        snaps=0
        for file in "$SNAPSHOT_DIR/$name/"*.img; do [[ -f $file && ! -L $file ]] && snaps=$((snaps + 1)); done
        printf -v row '%-24s %-7s %-11s %-10s %-9s %s' "$name" "$status" "$lifecycle" "$profile" "$((bytes / 1048576))M" "$snaps"
        rows+=("$row")
    done
    for file in "$SNAPSHOT_DIR/"*/*.img; do [[ ! -f $file || -L $file ]] || snapshots=$((snapshots + 1)); done
    if [[ -d $STORE_DIR ]]; then { read -r _; read -r _ _ _ free _; } < <(df -Ph "$STORE_DIR") || free=unknown; fi
    printf '%s workspaces   %s persistent   %s disposable   %s busy\n' "$total" "$persistent" "$ephemeral" "$busy"
    printf '%s in images   %s host free   %s snapshots\n' "$(human_bytes "$allocated")" "$free" "$snapshots"
    printf '\n%-24s %-7s %-11s %-10s %-9s %s\n' WORKSPACE STATE MODE PROFILE CAPACITY SNAPSHOTS
    if (( ${#rows[@]} )); then printf '%s\n' "${rows[@]}"; fi
    printf '\nStore: %s\n' "$STORE_DIR"
    if [[ -f $STORE_DIR/activity.tsv ]]; then printf '\nRecent activity\n'; activity 5; fi
    printf '\nCreate: --create NAME 4096 persistent build\nExplore: --help | --profiles | --doctor | --demo\n\n'
}
activity() {
    local count=${1:-20} c1 c2 c3 c4 c5
    if [[ -f $STORE_DIR/activity.tsv ]]; then
        while IFS=$'\t' read -r c1 c2 c3 c4 c5; do
            printf '%s  %-14s %-20s %s\n' "$c1" "$c2" "$c3" "$c4"
        done < <(tail -n "$count" "$STORE_DIR/activity.tsv")
    else printf 'No operations recorded yet. Create a workspace to get started.\n'; fi
}
show_logs() {
    local name=$1 log latest= entry_time entry_action entry_name entry_status entry_log has_journal=0
    local -A valid_logs=()
    valid_name "$name" || { fail "Invalid image name."; return 1; }
    if [[ -f $STORE_DIR/activity.tsv ]]; then
        has_journal=1
        while IFS=$'\t' read -r entry_time entry_action entry_name entry_status entry_log; do
            [[ $entry_name == "$name" && -n $entry_log ]] && valid_logs[$entry_log]=1
        done <"$STORE_DIR/activity.tsv"
    fi
    for log in "$LOG_DIR/$name-"*.log; do
        [[ -f $log && ! -L $log ]] || continue
        # Use the journal to avoid treating logs for "foo-bar" as logs for "foo".
        (( ! has_journal )) || [[ -n ${valid_logs[$log]:-} ]] || continue
        [[ -n $latest && ! $log -nt $latest ]] || latest=$log
    done
    [[ -n $latest ]] || { printf 'No completed operation logs for %s yet.\n' "$name"; return; }
    printf 'Log: %s\n\n' "$latest"
    tail -n 200 "$latest"
}
doctor() {
    local command missing=0 fs namespace
    printf 'CHROOTABLE / Host health\n\n'
    printf 'Host: %s / %s\nStore: %s\n\n' "$(uname -s)" "$(uname -m)" "$STORE_DIR"
    for command in "${REQUIRED_COMMANDS[@]}"; do
        if ! command -v "$command" >/dev/null 2>&1; then
            printf '[MISSING] %-14s install %s\n' "$command" "$(package_for_command "$command")"
            missing=$((missing + 1))
        fi
    done
    (( missing != 0 )) || printf '[OK] Host commands are available.\n'
    if [[ -r /usr/share/keyrings/debian-archive-keyring.gpg ]]; then
        printf '[OK] Debian archive signing keys are available.\n'
    else
        printf '[MISSING] Debian archive signing keys; run --setup.\n'
        missing=$((missing + 1))
    fi
    for fs in ext4 overlay; do
        if awk -v fs="$fs" '$NF==fs {found=1} END {exit !found}' /proc/filesystems; then printf '[OK] Kernel filesystem: %s\n' "$fs"
        else printf '[INFO] %s is not loaded; it may be available as a kernel module.\n' "$fs"; fi
    done
    for namespace in mnt uts ipc pid net; do
        if [[ -e /proc/self/ns/$namespace ]]; then printf '[OK] Namespace: %s\n' "$namespace"
        else printf '[MISSING] Namespace: %s\n' "$namespace"; missing=$((missing + 1)); fi
    done
    if [[ -e /dev/loop-control ]]; then printf '[OK] Loop device control exists.\n'
    else printf '[INFO] /dev/loop-control is unavailable; image mounts may be blocked.\n'; fi
    if [[ -d $STORE_DIR ]]; then
        if [[ -r $STORE_DIR && -x $STORE_DIR ]]; then printf '[OK] Store is readable.\n'; df -Ph "$STORE_DIR"
        else printf '[INFO] Store needs root access.\n'; fi
    else printf '[INFO] Store will be created on the first write operation.\n'; fi
    printf '\nMount permissions are not tested by this read-only check.\n'
    printf 'Install missing tools: sudo %s --setup\n' "$0"
    (( missing == 0 ))
}

ui_init() {
    [[ -t 0 && -t 1 ]] || { fail "The menu needs a terminal. Use --dashboard, --list, or --help for command-line output."; return 1; }
    command -v whiptail >/dev/null || { fail "Install whiptail to use the menu (sudo apt-get install whiptail)."; return 1; }
    local rows columns
    read -r rows columns < <(stty size 2>/dev/null) || { rows=24; columns=80; }
    (( rows >= 24 && columns >= 80 )) || { fail "The menu needs at least 80 columns by 24 rows. Enlarge the terminal or use --dashboard."; return 1; }
    UI_HEIGHT=$((rows - 2)); (( UI_HEIGHT <= 30 )) || UI_HEIGHT=30
    UI_WIDTH=$((columns - 2)); (( UI_WIDTH <= 104 )) || UI_WIDTH=104
    export NEWT_COLORS="${NEWT_COLORS:-root=white,black window=white,black border=cyan,black title=cyan,black roottext=cyan,black textbox=white,black acttextbox=white,black entry=white,blue label=cyan,black listbox=white,black actlistbox=black,cyan sellistbox=black,cyan actsellistbox=black,cyan button=black,cyan actbutton=black,white compactbutton=black,cyan checkbox=white,black actcheckbox=black,cyan}"
    NON_INTERACTIVE=0
}
ui() {
    local backtitle="CHROOTABLE  /  Debian environment workbench  /  $APP_VERSION"
    (( DEMO == 0 )) || backtitle="CHROOTABLE  /  DEMO - sample workspaces, no mounts or downloads"
    whiptail --title "$APP_NAME" --backtitle "$backtitle" "$@"
}
ui_message() { ui --msgbox "$1" "$UI_HEIGHT" "$UI_WIDTH" --scrolltext; }
ui_view() {
    local title=$1 content=$2 temporary status=0
    temporary=$(mktemp /tmp/chrootable-view.XXXXXX) || return
    printf '%s\n\n%s\n' "$title" "$content" >"$temporary"
    ui --textbox "$temporary" "$UI_HEIGHT" "$UI_WIDTH" --scrolltext || status=$?
    rm -f -- "$temporary"
    return "$status"
}
ui_run() {
    if (( DEMO )); then ui_message "This is a read-only demo.\n\nRun sudo $0 to create real workspaces and use this action."; return; fi
    local output status=0
    output=$(mktemp /tmp/chrootable-result.XXXXXX) || return
    ui --infobox "Working...\n\nDetailed logs are in:\n$LOG_DIR\n\nThe workspace menu will return when the operation finishes." 11 "$UI_WIDTH" || true
    "$@" >"$output" 2>&1 || status=$?
    local heading="Operation completed"
    (( status == 0 )) || heading="Operation failed (status $status)"
    ui_view "$heading" "$(tail -n 30 "$output")" || true
    rm -f -- "$output"
}
ui_session() {
    local image=$1 lifecycle=$2 network=$3 status=0
    if (( DEMO )); then ui_message "This preview never mounts an image.\n\nIn a real workspace, this opens a $lifecycle shell with $network networking. Exit returns you to this menu."; return; fi
    printf '\033[H\033[2J'
    enter_chrootable "$image" "$lifecycle" "$network" "" 0 || status=$?
    (( status == 0 )) || ui_message "The session exited with status $status.\n\nSee Recent log for operation details."
    return 0
}
choose_lifecycle() {
    ui --menu "How should this workspace remember changes?" 13 "$UI_WIDTH" 2 \
        persistent "Keep changes after each session" ephemeral "Discard session writes; reuse the base image" 3>&1 1>&2 2>&3
}
create_chrootable() {
    local name profile size lifecycle suggested=2048
    profile=$(ui --menu "Start with a purpose. Each profile is Debian minbase plus a focused set of tools." 16 "$UI_WIDTH" 4 \
        minimal "Clean Debian base" build "C/C++, make, Git and build tools" python "Python, virtual environments, pip and Git" network "DNS, HTTP, SSH and network diagnostics" 3>&1 1>&2 2>&3) || return 0
    name=$(ui --inputbox "Workspace name (letters, digits, dot, underscore, hyphen):" 10 "$UI_WIDTH" "$profile-lab" 3>&1 1>&2 2>&3) || return 0
    valid_name "$name" || { ui_message "Invalid name. Start with a letter or digit; use at most 64 characters."; return; }
    [[ $profile != build && $profile != python ]] || suggested=4096
    size=$(ui --inputbox "Image capacity in MiB. Suggested for $profile: $suggested MiB.\nThe image is fully allocated when created." 11 "$UI_WIDTH" "$suggested" 3>&1 1>&2 2>&3) || return 0
    valid_size_mib "$size" || { ui_message "Enter a whole number from 1 to 1048576 MiB."; return; }
    lifecycle=$(choose_lifecycle) || return 0
    ui --yesno "Create $name?\n\nDebian: $DEBIAN_SUITE\nProfile: $profile\nCapacity: $size MiB\nSessions: $lifecycle\n\nThis downloads Debian and the selected profile packages." 17 "$UI_WIDTH" || return 0
    ui_run create_image "$name" "$size" "$lifecycle" "$profile"
}
ui_snapshots() {
    local name=$1 image="$IMAGE_DIR/$1.img" snapshot label choice action
    local -a entries=()
    while true; do
        entries=()
        [[ ! -f $image ]] || entries=(/new "Save the current workspace")
        for snapshot in "$SNAPSHOT_DIR/$name/"*.img; do
            [[ -f $snapshot && ! -L $snapshot ]] || continue
            entries+=("$(basename "$snapshot" .img)" "$(metadata_value "$snapshot" snapshot_at unknown) / $(image_size_mib "$snapshot") MiB")
        done
        choice=$(ui --cancel-button Back --menu "$name / Recovery points\n\nRestoring saves the current image as a recovery snapshot first." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 11))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
        if [[ $choice == /new ]]; then
            label=$(ui --inputbox "Snapshot label:" 10 "$UI_WIDTH" "checkpoint-$(date +%Y%m%d-%H%M%S)" 3>&1 1>&2 2>&3) || continue
            ui_run snapshot_image "$image" "$label"
        else
            action=$(ui --cancel-button Back --menu "$name / $choice" 13 "$UI_WIDTH" 2 restore "Restore this recovery point" delete "Delete this snapshot" 3>&1 1>&2 2>&3) || continue
            case $action in
                restore)
                    ui --defaultno --yesno "Restore '$choice'?\n\nThe current image will be saved as a before-restore snapshot. The selected snapshot stays available." 12 "$UI_WIDTH" || continue
                    ui_run restore_image "$name" "$choice" ;;
                delete)
                    ui --defaultno --yesno "Permanently delete snapshot '$choice'?\n\nThis removes only this recovery point." 11 "$UI_WIDTH" || continue
                    ui_run drop_snapshot "$name" "$choice" ;;
            esac
        fi
    done
}
image_action_menu() {
    local image=$1 choice value name lifecycle
    name=$(basename "$image" .img)
    while [[ -f $image ]]; do
        lifecycle=$(image_lifecycle "$image")
        choice=$(ui --cancel-button Back --menu "$(image_details "$image")" "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 15))" \
            enter "Open a $lifecycle root shell" try "Try changes in a disposable session" offline "Open a shell without host network access" \
            snapshots "Save or restore recovery points" clone "Create an independent copy" resize "Expand image capacity" \
            mode "Switch persistent / ephemeral sessions" export "Export filesystem as .tar.gz" logs "Read the latest operation log" \
            repair "Check and repair the ext4 filesystem" delete "Delete image (retain snapshots and exports)" 3>&1 1>&2 2>&3) || return 0
        case $choice in
            enter) ui_session "$image" "$lifecycle" shared ;;
            try) ui_session "$image" ephemeral shared ;;
            offline) ui_session "$image" "$lifecycle" isolated ;;
            snapshots) ui_snapshots "$name" ;;
            clone)
                value=$(ui --inputbox "Name for the new copy:" 10 "$UI_WIDTH" "${name:0:59}-copy" 3>&1 1>&2 2>&3) || continue
                ui_run clone_image "$image" "$value" ;;
            resize)
                value=$(ui --inputbox "New capacity in MiB (expansion only):\nCurrent: $(image_size_mib "$image") MiB" 11 "$UI_WIDTH" "$(( $(image_size_mib "$image") + 1024 ))" 3>&1 1>&2 2>&3) || continue
                ui_run resize_image "$image" "$value" ;;
            mode) value=$(choose_lifecycle) || continue; ui_run set_lifecycle "$image" "$value" ;;
            export) ui_run export_image "$image" ;;
            logs) ui_view "$name / Recent log" "$(show_logs "$name")" || true ;;
            repair)
                ui --defaultno --yesno "Run forced ext4 repair on '$name'?\n\nRepair can change filesystem data. Save a snapshot first if you need a recovery point." 12 "$UI_WIDTH" || continue
                ui_run repair_image "$image" ;;
            delete)
                value=$(ui --inputbox "Type $name to permanently delete its image.\nSnapshots and exports will be retained." 11 "$UI_WIDTH" 3>&1 1>&2 2>&3) || continue
                [[ $value == "$name" ]] || { ui_message "The name did not match. Nothing was deleted."; continue; }
                ui_run delete_image "$image" ;;
        esac
    done
}
select_chrootable() {
    local image name choice filter=; local -a entries=()
    while true; do
        entries=(/search "Filter workspaces by name")
        for image in "$IMAGE_DIR/"*.img; do
            [[ -f $image && ! -L $image ]] || continue
            name=$(basename "$image" .img); valid_name "$name" || continue
            [[ ${name,,} == *"${filter,,}"* ]] || continue
            entries+=("$name" "$(image_status "$image") / $(image_lifecycle "$image") / $(image_size_mib "$image") MiB / $(metadata_value "$image" profile minimal)")
        done
        choice=$(ui --cancel-button Back --menu "Your workspaces\nFilter: ${filter:-all}  |  Choose a workspace to open its tools." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 10))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
        if [[ $choice == /search ]]; then
            filter=$(ui --inputbox "Name contains (leave empty to show all):" 10 "$UI_WIDTH" "$filter" 3>&1 1>&2 2>&3) || filter=
        else image_action_menu "$IMAGE_DIR/$choice.img"; fi
    done
}
recovery_library() {
    local directory name choice; local -a entries=()
    for directory in "$SNAPSHOT_DIR/"*/; do
        [[ -d $directory && ! -L ${directory%/} ]] || continue
        name=${directory%/}; name=${name##*/}
        [[ $(snapshot_count "$name") != 0 ]] || continue
        entries+=("$name" "$(snapshot_count "$name") snapshots")
    done
    if (( ${#entries[@]} == 0 )); then ui_message "No snapshots yet.\n\nOpen a workspace and choose Snapshots to save your first recovery point."; return; fi
    choice=$(ui --cancel-button Back --menu "Recovery library\nIncludes snapshots of deleted workspaces." "$UI_HEIGHT" "$UI_WIDTH" "$((UI_HEIGHT - 10))" "${entries[@]}" 3>&1 1>&2 2>&3) || return 0
    ui_snapshots "$choice"
}
main_menu() {
    local choice hint
    while true; do
        hint="Build something. Break things. Keep a recovery point."
        [[ -d $IMAGE_DIR ]] && compgen -G "$IMAGE_DIR/*.img" >/dev/null || hint="Start with New workspace. Choose a profile; make it your own."
        choice=$(ui --cancel-button Quit --menu "$(workspace_summary)\n\n$hint" "$UI_HEIGHT" "$UI_WIDTH" 7 \
            workspaces "Open your workspace library" new "Create a workspace from a profile" recovery "Browse snapshots, including deleted workspaces" \
            activity "See recent operations" health "Check host tools and kernel support" profiles "Explore development profiles" help "Shortcuts, workflows and isolation notes" 3>&1 1>&2 2>&3) || return 0
        case $choice in
            workspaces) select_chrootable ;; new) create_chrootable ;; recovery) recovery_library ;;
            activity) ui_view "Workspace activity" "$(activity)" || true ;;
            health) ui_view "Host health" "$(doctor || true)" || true ;;
            profiles) ui_view "Start with a purpose" "$(list_profiles)" || true ;;
            help) ui_view "Field guide" "$(usage)\n\nSessions run as host root and expose host devices. Chroots are development environments, not a security sandbox.\n\nUse --try to discard filesystem changes; add --isolated to remove host network access. Host device writes remain possible.\n\nNavigate: arrows select, Enter opens, Tab changes button, Escape goes back." || true ;;
        esac
    done
}

cleanup_demo() {
    local name
    for name in build-lab python-playground network-kit; do
        rm -f -- "$IMAGE_DIR/$name.img" "$IMAGE_DIR/$name.img.meta"
    done
    rm -f -- "$SNAPSHOT_DIR/build-lab/clean-base.img" "$SNAPSHOT_DIR/build-lab/clean-base.img.meta"
    rmdir "$SNAPSHOT_DIR/build-lab" "$IMAGE_DIR" "$LOG_DIR" "$EXPORT_DIR" "$SNAPSHOT_DIR" "$STORE_DIR"
}
run_demo() (
    DEMO=1
    STORE_DIR=$(mktemp -d /tmp/chrootable-demo.XXXXXX) || return
    configure_paths
    trap cleanup_demo EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    init_store || return
    local name profile lifecycle size
    for name in build-lab python-playground network-kit; do
        case $name in
            build-lab) profile=build; lifecycle=persistent; size=4096 ;;
            python-playground) profile=python; lifecycle=ephemeral; size=4096 ;;
            network-kit) profile=network; lifecycle=ephemeral; size=2048 ;;
        esac
        truncate -s "${size}M" "$IMAGE_DIR/$name.img" || return
        write_metadata "$IMAGE_DIR/$name.img" "$lifecycle" stable "$(dpkg --print-architecture)" "$size" "$(timestamp)" never "$profile" || return
    done
    install -d -m 0700 "$SNAPSHOT_DIR/build-lab" || return
    truncate -s 4096M "$SNAPSHOT_DIR/build-lab/clean-base.img" || return
    copy_metadata "$IMAGE_DIR/build-lab.img" "$SNAPSHOT_DIR/build-lab/clean-base.img" || return
    metadata_set "$SNAPSHOT_DIR/build-lab/clean-base.img" snapshot_at "$(timestamp)" || return
    if [[ ${1:-} == --dashboard ]]; then
        printf 'DEMO / sample workspaces / no mounts or downloads\n'
        dashboard
    else ui_init && main_menu; fi
)

usage() {
    printf '%s\n' "Chrootable Manager $APP_VERSION - Debian environment workbench" '
Usage: chrootable-manager [COMMAND]
No command opens the terminal dashboard (root required).

Explore (no root required when the store is readable)
